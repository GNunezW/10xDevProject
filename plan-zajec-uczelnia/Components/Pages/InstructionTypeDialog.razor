@inject IInstructionTypeService TypeService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="Model">
            <MudTextField @bind-Value="Model.Name" Label="Nazwa typu" Required="true"
                          MaxLength="50" Class="mb-3" />
            <MudNumericField T="int" @bind-Value="Model.MaxStudentsPerGroup"
                             Label="Max studentów w grupie" Min="1" Required="true" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Anuluj</MudButton>
        <MudButton Color="Color.Primary" OnClick="SubmitAsync">Zapisz</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public InstructionType Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }

    private MudForm _form = default!;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        try
        {
            if (IsEdit)
                await TypeService.UpdateAsync(Model);
            else
                await TypeService.CreateAsync(Model);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            Snackbar.Add("Typ o tej nazwie już istnieje.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
